# Copy to lambda.env (gitignored) and fill in. The runner never prints these values.
# API key: Lambda dashboard -> API keys.
LAMBDA_API_KEY=
# The name you gave this laptop's public key at Lambda (dashboard -> SSH keys).
LAMBDA_SSH_KEY_NAME=
# The matching PRIVATE key file (not the .pub). A passphrase key must be loaded in ssh-agent.
LAMBDA_SSH_KEY=~/.ssh/id_ed25519
# Optional: LAMBDA_REGION (default: the first region with capacity),
# LAMBDA_API_URL (default https://cloud.lambda.ai/api/v1).
